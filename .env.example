# API keys for miniAgent providers
# Copy this file to .env and fill in your keys.
# NEVER commit real keys to git.

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Used for: openai/gpt-4o, openai/gpt-4o-mini, openai/o1, etc.
OPENAI_API_KEY=your-openai-api-key-here

# ── Anthropic ────────────────────────────────────────────────────────────────
# Used for: anthropic/claude-sonnet-4-6, anthropic/claude-haiku-4-5, etc.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Google Gemini ────────────────────────────────────────────────────────────
# Used for: gemini/gemini-2.0-flash, gemini/gemini-1.5-pro, etc.
GEMINI_API_KEY=your-gemini-api-key-here

# ── Groq ─────────────────────────────────────────────────────────────────────
# Used for: groq/llama-3.1-70b-versatile, groq/mixtral-8x7b, etc.
GROQ_API_KEY=your-groq-api-key-here

# ── API server (optional) ─────────────────────────────────────────────────────
# Override these to configure the REST server (python -m miniagent).
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info
# RELOAD=false
# AGENTS_CONFIG_PATH=agents.yaml
# Browser origins allowed to call the API; unset blocks cross-origin calls.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
